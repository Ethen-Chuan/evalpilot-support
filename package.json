{
  "name": "evalpilot-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build_service_prd.mjs && tsc -b && vite build",
    "build:public": "tsc -b && node scripts/build_public_site.mjs",
    "prepare:pages": "tsc -b && node scripts/build_public_site.mjs --publish",
    "start": "bash start.sh",
    "test": "python3 -m unittest discover -s tests -v"
  },
