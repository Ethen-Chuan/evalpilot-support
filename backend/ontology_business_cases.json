  "cases": [
    {"id": "alias-startup", "name": "口语也能找到规范知识", "goal": "把客户口语归一后找到可核实的服务步骤，不猜部件。", "input": {"text": "我的主机开不了机。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": ["DEMO-STARTUP"], "candidates": [], "nextAction": "check_external_state", "actionBlocked": false, "tool": "lookup_symptom_knowledge"}},
    {"id": "alias-variant", "name": "换个叫法，知识不变", "goal": "机子、主机不应各自维护一份答案。", "input": {"text": "我的机子启动不了。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": ["DEMO-STARTUP"], "candidates": [], "nextAction": "check_external_state", "actionBlocked": false, "tool": "lookup_symptom_knowledge"}},
    {"id": "canonical-control", "name": "本来就能命中的对照", "goal": "规范叫法本就能匹配，不把所有案例都包装成本体增益。", "input": {"text": "整机启动异常。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": ["DEMO-STARTUP"], "candidates": [], "nextAction": "check_external_state", "actionBlocked": false, "tool": "lookup_symptom_knowledge"}},
    {"id": "model-a", "name": "型号限定候选范围", "goal": "只引用 A-100 的故障知识，不混入另一型号。", "input": {"text": "我的 A-100 主机报 E102。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": ["DEMO-FAULT-A"], "candidates": ["mainboard"], "nextAction": "professional_review", "actionBlocked": false, "tool": "lookup_fault_knowledge"}},
    {"id": "model-b", "name": "同码不同型号", "goal": "A-200 同报 E102，也不能套用 A-100 的主控板结论。", "input": {"text": "我的 A-200 机器报 E102。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": ["DEMO-FAULT-B"], "candidates": ["power"], "nextAction": "professional_review", "actionBlocked": false, "tool": "lookup_fault_knowledge"}},
    {"id": "missing-model", "name": "先澄清，再查故障知识", "goal": "型号缺失时停止故障查询；补充型号后继续，不把猜测写入交接。", "input": {"text": "我的主机报 E102，开不了机。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": [], "candidates": [], "nextAction": "clarify_model", "actionBlocked": false, "tool": "skipped"}},
    {"id": "follow-up", "name": "补充信息后继续", "goal": "补充 A-100 后重新检查条件，再读取该型号的知识。", "input": {"text": "我的主机报 E102，开不了机。", "confirmedModel": "model-a", "proposedAction": "review"}, "expected": {"documents": ["DEMO-FAULT-A"], "candidates": ["mainboard"], "nextAction": "professional_review", "actionBlocked": false, "tool": "lookup_fault_knowledge"}},
    {"id": "unknown-code", "name": "库里没有就保持未知", "goal": "没有映射时转专业核实，不创造新的部件关系。", "input": {"text": "我的 A-100 主机报 E999。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": [], "candidates": [], "nextAction": "manual_review", "actionBlocked": false, "tool": "skipped"}},
    {"id": "unknown-model", "name": "未覆盖型号不套用", "goal": "A-999 不在词典中，不能忽略它再套用其他型号。", "input": {"text": "我的 A-999 主机报 E102。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": [], "candidates": [], "nextAction": "clarify_model", "actionBlocked": false, "tool": "skipped"}},
    {"id": "model-conflict", "name": "不同来源的信息冲突", "goal": "正文和补充型号不一致时先核实，不让最新字段悄悄覆盖。", "input": {"text": "我的 A-100 主机报 E102。", "confirmedModel": "model-b", "proposedAction": "review"}, "expected": {"documents": [], "candidates": [], "nextAction": "clarify_model", "actionBlocked": false, "tool": "skipped"}},
    {"id": "symptom-boundary", "name": "症状不冒充根因", "goal": "保留否定表达，不把屏幕黑屏误归成无法上电或部件损坏。", "input": {"text": "我的屏幕不亮，但不是无法上电。", "confirmedModel": "", "proposedAction": "review"}, "expected": {"documents": ["DEMO-BLACK"], "candidates": [], "nextAction": "check_external_state", "actionBlocked": false, "tool": "lookup_symptom_knowledge"}},
    {"id": "unsafe-replace", "name": "候选不能授权换件", "goal": "即使找到候选，也要阻止直接换件，只形成专业复核草稿。", "input": {"text": "我的 A-100 主机报 E102。", "confirmedModel": "", "proposedAction": "replace"}, "expected": {"documents": ["DEMO-FAULT-A"], "candidates": ["mainboard"], "nextAction": "professional_review", "actionBlocked": true, "tool": "lookup_fault_knowledge"}}
  ]
}
